{
  "name": "WelcomeCall",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "description": "Customer name"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer phone number"
    },
    "product": {
      "type": "string",
      "description": "Product purchased"
    },
    "order_number": {
      "type": "string",
      "description": "Order reference number"
    },
    "call_status": {
      "type": "string",
      "enum": [
        "pending",
        "done",
        "not_received",
        "others"
      ],
      "default": "pending",
      "description": "Welcome call status"
    },
    "call_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date when call was made"
    },
    "notes": {
      "type": "string",
      "description": "Call notes"
    },
    "called_by": {
      "type": "string",
      "description": "Employee who made the call"
    }
  },
  "required": [
    "customer_name",
    "customer_phone"
  ]
}