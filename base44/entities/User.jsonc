{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Platform role \u2014 admin has full access, user has restricted access"
    },
    "employee_id": {
      "type": "string",
      "description": "Unique employee identification number"
    },
    "display_name": {
      "type": "string",
      "description": "User's preferred display name across the ERP"
    },
    "department": {
      "type": "string",
      "enum": [
        "biddabari_publication",
        "it",
        "boibari",
        "admission",
        "service",
        "marketing",
        "prodhan_com_e_commerce",
        "sales",
        "r_and_d",
        "finance",
        "hr",
        "operations"
      ],
      "description": "Employee department"
    },
    "designation": {
      "type": "string",
      "description": "Job title/position"
    },
    "job_role": {
      "type": "string",
      "enum": [
        "super_admin",
        "admin",
        "finance_head",
        "accountant",
        "hr_manager",
        "hr_executive",
        "sales_manager",
        "sales_executive",
        "marketing_manager",
        "marketing_executive",
        "inventory_manager",
        "procurement_officer",
        "department_head",
        "manager",
        "employee"
      ],
      "default": "employee",
      "description": "Organizational job role for granular permissions"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "joining_date": {
      "type": "string",
      "format": "date",
      "description": "Employee joining date"
    },
    "base_salary": {
      "type": "number",
      "description": "Monthly base salary"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Employee active status"
    },
    "admission_target": {
      "type": "number",
      "description": "Monthly admission target"
    },
    "incentive_rate": {
      "type": "number",
      "description": "Default incentive rate percentage"
    },
    "performance_points": {
      "type": "number",
      "default": 0,
      "description": "Gamification points earned"
    },
    "attendance_deduction_rate": {
      "type": "number",
      "default": 0,
      "description": "Percentage deduction per absence (0-100)"
    },
    "late_deduction_rate": {
      "type": "number",
      "default": 0,
      "description": "Percentage deduction per late arrival (0-100)"
    },
    "absence_penalty_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed_amount"
      ],
      "default": "percentage",
      "description": "Type of penalty calculation"
    },
    "max_allowed_absences": {
      "type": "number",
      "default": 3,
      "description": "Max absences per month before penalties"
    },
    "max_allowed_lates": {
      "type": "number",
      "default": 5,
      "description": "Max late arrivals per month before penalties"
    },
    "profile_picture_url": {
      "type": "string",
      "description": "Profile picture URL"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "WhatsApp number"
    },
    "whatsapp_activated": {
      "type": "boolean",
      "default": false
    },
    "whatsapp_activated_date": {
      "type": "string",
      "format": "date-time"
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false
    },
    "can_view_financial_data": {
      "type": "boolean",
      "default": false,
      "description": "Permission to view financial data"
    },
    "last_password_change": {
      "type": "string",
      "format": "date-time"
    },
    "session_timeout_minutes": {
      "type": "number",
      "default": 1440,
      "description": "Session timeout in minutes"
    },
    "failed_login_attempts": {
      "type": "number",
      "default": 0
    },
    "account_locked_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "department",
    "designation",
    "phone"
  ]
}