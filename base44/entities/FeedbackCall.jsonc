{
  "name": "FeedbackCall",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Reference to the Order entity"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer phone number"
    },
    "product": {
      "type": "string",
      "description": "Product purchased"
    },
    "order_number": {
      "type": "string",
      "description": "Order reference number"
    },
    "feedback_status": {
      "type": "string",
      "enum": [
        "pending",
        "happy",
        "unhappy",
        "others"
      ],
      "default": "pending",
      "description": "Feedback call status"
    },
    "delivery_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Whether delivery is confirmed by courier or manually"
    },
    "delivery_source": {
      "type": "string",
      "enum": [
        "courier_api",
        "manual",
        "auto_aged"
      ],
      "description": "How the order entered feedback queue"
    },
    "call_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date when call was made"
    },
    "feedback_notes": {
      "type": "string",
      "description": "Detailed feedback notes"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Customer rating 1-5"
    },
    "called_by": {
      "type": "string",
      "description": "Employee who made the call"
    }
  },
  "required": [
    "customer_name",
    "customer_phone"
  ]
}